TESSER_BASE_URL=https://sandbox.tesserx.co
TESSER_AUTH_URL=https://dev-awqy75wdabpsnsvu.us.auth0.com/oauth/token
DEBUG_MODE=false

# Get this from the Tesser sandbox dashboard
TESSER_CLIENT_ID=
TESSER_CLIENT_SECRET=

# A for without tenant, B for with tenants, or BOTH for both
ENABLE_VARIANTS=B

# Payout network: STELLAR (default) or an EVM testnet such as ETHEREUM_SEPOLIA
PAYMENT_NETWORK=STELLAR

# Must match PAYMENT_NETWORK. Leave it empty to use the default for that network.
# A Stellar address must have a USDC trustline.
# EVM sandbox risk-test addresses:
#   0xd3f72b3e91c8124dfc1b4273e93594bb00c9be6f  automatically approved (EVM default)
#   0x0a5b2bf3ccfb44c1d22f07eed9553ecba752d4ad  held for review; the E2E approves it
#   0xac4cc4b68ea24bbfaac8fd127b67ed445accce22  automatically rejected; the E2E fails
BENEFICIARY_WALLET_ADDRESS=GCE5TKW3KAJJB3DPKXFWRIAKJEVOW6BDFGO6R4NRWS2JSZWRYNB2NKQG

# Circle Mint sandbox API key - used for:
# 1. Storing in Tesser vault (organization secrets API)
# 2. Checking the Circle account has a linked wire bank (index.ts preflight)
# 3. Testing Circle API directly (circle-payment-test.ts)
CIRCLE_API_KEY=

# Only used for circle-payment-test.ts
CIRCLE_FROM_WALLET_ID=
CIRCLE_TO_WALLET_ID=

# Only used for the helper scripts (see README)
TESSER_FROM_ACCOUNT_ID=
TESSER_TO_ACCOUNT_ID=
